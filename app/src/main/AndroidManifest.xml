<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Gym: the workout/rest-timer service (a timer is the textbook "special use"), a
         partial wake lock only for the length of a rest, and the buzz at zero. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Presence: geofencing computed ON-DEVICE (geo/PresenceWorker) — coordinates never
         leave the phone, only place labels. Background = the periodic check keeps working
         with the app closed (Android gates it behind its own deliberate grant). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Health Connect: read-only, the four data families we sync -->
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Discover the Health Connect app + its permissions UI, and Spotify (App Remote
         binds its service for the wake_spotify action — package visibility, API 30+) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.spotify.music" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <!-- allowBackup=false: the brain token and (encrypted) geofence coordinates must never
         ride a cloud backup off this device (crumpet docs/backlog/presence.md threat model). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Crumpet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Crumpet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect privacy-policy / rationale entry points -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- API 34+ rationale -->
        <!-- Full-screen face; drops into picture-in-picture when another app takes over.
             configChanges keeps the WebView (and its live state-WS) alive through the
             PiP resize instead of recreating the activity mid-shrink. -->
        <activity
            android:name=".ui.FaceActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.Crumpet" />

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Holds the gateway connection open so Crumpet's nudges arrive as notifications -->
        <service
            android:name=".push.PresenceService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Workout in progress + rest countdown (gym/GymSessionService) -->
        <service
            android:name=".gym.GymSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Workout session and rest timer: an ongoing countdown that alerts at zero with the screen off." />
        </service>

        <!-- Hands the downloaded update APK to the installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
